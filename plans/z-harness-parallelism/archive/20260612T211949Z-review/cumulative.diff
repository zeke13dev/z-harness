+    # plan_dir override is only meaningful for --slug; for --slugs/--plan-set it is None.
+    plan_dir_override = getattr(args, "plan_dir", None)
+    sys.exit(await run_single_plan(slug, plan_dir_override, config, repo_root))
 
 
