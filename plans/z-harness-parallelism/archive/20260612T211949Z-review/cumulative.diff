+      "kind": "fn",
+      "summary": "Acquires plan-claim locks in SORTED ascending slug order (INV-6: deadlock-free). Releases all on any failure. Returns held locks."
+    },
+    {
+      "file": "scripts/hermes/cross_plan.py",
+      "line": 314,
+      "symbol": "schedule_batches",
+      "kind": "fn",
+      "summary": "Greedy batch coloring over the plan conflict graph: disjoint plans grouped in same batch, conflicting plans serialized. Returns ordered list of batches."
+    },
+    {
+      "file": "scripts/generate-workstreams.py",
+      "line": 384,
+      "symbol": "assign_ws_depths",
+      "kind": "fn",
+      "summary": "Computes longest-path depth for each workstream over the depends_on DAG. Sets parallel_group='level-{depth}'. Same-depth workstreams are mutually independent by construction."
+    },
+    {
+      "file": "scripts/generate-workstreams.py",
+      "line": 475,
+      "symbol": "parse_task_files",
+      "kind": "fn",
+      "summary": "Parses **Files:** lines from each task block in TASKS.md to derive per-workstream file scope. If any task lacks a parseable **Files:** line, scope_unknown=True → conservative full serialization (INV-4)."
+    },
+    {
+      "file": "scripts/hermes/merge.py",
+      "line": 28,
+      "symbol": "merge_workstream",
+      "kind": "fn",
+      "summary": "Synchronous git merge of hermes/<slug>/<ws_id> into base. Called under the in-process asyncio.Lock — never runs concurrently across workstreams or plans."
+    }
+  ],
+  "invariants": [
+    "INV-1: Concurrent workstreams write to isolated git worktrees; the working tree is never shared.",
+    "INV-2: depends_on is the sole scheduling gate — a workstream starts only when all its depends_on IDs reach 'done'. parallel_group is a derived label, NOT a scheduling mechanism.",
+    "INV-3: merge_order is authoritative for merge sequence — merges always proceed in declared order, never in completion order.",
+    "INV-4: scope_unknown=True or serialize_all=True forces fully-sequential execution (singleton sub-batches). Silent blind parallelism is forbidden when conflict data is absent or low-confidence.",
+    "INV-5: max_parallel_workstreams=1 (default) reproduces pre-v1.3 sequential behavior exactly. cap=1 ≡ legacy sequential.",
+    "INV-6: Plan-claim locks are always acquired in sorted ascending slug order — prevents AB/BA deadlocks across concurrent super-orchestrators.",
+    "INV-7: parallel_group and scope_unknown are additive fields (forward-compatible). Pre-v1.3 manifests omitting scope_unknown default to false; null parallel_group treated as scope_unknown (fail-safe)."
+  ],
+  "gotchas": [
+    "Semaphore is held for the FULL run_workstream lifetime (spawn → monitor → merge), not just at spawn time. This bounds live sessions, not spawn rate (audit M1).",
+    "poll_session runs via asyncio.to_thread so one stalled poll cannot starve sibling coroutines.",
+    "GIT_OPTIONAL_LOCKS=0 is set for the run and restored after — prevents concurrent git gc contention against the shared object store.",
+    "Non-file shared state (databases, ports, remote sandboxes, in-memory caches) is NOT protected by the file-conflict layer. Use HERMES_SERIALIZE_ALL=1 to force fully-sequential execution when workstreams share such resources.",
+    "scope_unknown is derived from parse_task_files: if ANY task block in TASKS.md lacks a parseable **Files:** line, the entire plan is treated as scope_unknown=True.",
+    "The merge_lock is a single in-process asyncio.Lock — it serializes merges across all workstreams AND all plans within one run_cross_plan call. Two plans never merge concurrently.",
+    "cap=1 is the safe default — parallelism is opt-in via HERMES_MAX_PARALLEL / HERMES_MAX_PARALLEL_PLANS. Do not raise caps in production without first verifying workstreams have no non-file shared-state dependencies."
+  ],
+  "config_keys": {
+    "note": "All Hermes concurrency knobs are ENV-ONLY, read by scripts/hermes/config.py ConcurrencyConfig. They map to ConcurrencyConfig fields.",
+    "concurrency": [
+      {"key": "HERMES_MAX_PARALLEL", "field": "max_parallel_workstreams", "default": "1", "description": "Max workstreams running concurrently within a single plan. Default 1 = legacy sequential (INV-5). Semaphore held for full workstream lifetime."},
+      {"key": "HERMES_MAX_PARALLEL_PLANS", "field": "max_parallel_plans", "default": "1", "description": "Max plans running concurrently in a cross-plan run. Default 1."},
+      {"key": "HERMES_SERIALIZE_ALL", "field": "serialize_all", "default": "0", "description": "Force fully-sequential execution regardless of conflict analysis. Use when workstreams share non-file state (DBs, ports). Equivalent to scope_unknown=True for scheduling."},
+      {"key": "HERMES_SERIALIZE_HIGH_SEVERITY", "field": "serialize_high_severity", "default": "1", "description": "When True, HIGH-severity file_conflicts edges force serialization within a level even when max_parallel_workstreams > 1."}
+    ]
+  },
+  "runbook": {
+    "within_plan_parallel": "HERMES_MAX_PARALLEL=N python3 scripts/hermes-execute.py --slug <slug>",
+    "cross_plan_slugs": "HERMES_MAX_PARALLEL_PLANS=N python3 scripts/hermes-execute.py --slugs a,b,c",
+    "cross_plan_file": "HERMES_MAX_PARALLEL_PLANS=N python3 scripts/hermes-execute.py --plan-set plans.txt",
+    "serialize_all": "HERMES_SERIALIZE_ALL=1 python3 scripts/hermes-execute.py --slug <slug>",
+    "non_file_shared_state_note": "If workstreams share databases, ports, remote sandboxes, or other process-level resources, set HERMES_SERIALIZE_ALL=1. The file_conflicts layer does not model these dependencies."
+  }
+}
