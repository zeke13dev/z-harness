+MERGE_BASE="$(git merge-base HEAD origin/main 2>/dev/null || true)"
+if [[ -n "$MERGE_BASE" ]] && git rev-parse --verify "${MERGE_BASE}^{commit}" >/dev/null 2>&1; then
+  BASE_REF="$MERGE_BASE"
+elif git rev-parse --verify "HEAD~5^{commit}" >/dev/null 2>&1; then
+  BASE_REF="HEAD~5"
+else
+  BASE_REF="$EMPTY_TREE"
+fi
+
