+if git diff --quiet "${BASE_REF}..HEAD" 2>/dev/null; then
+  echo "STATUS: skipped empty_diff"
+  if [[ -x "$LOG_EVENT" ]]; then
+    bash "$LOG_EVENT" "$RUN" "phase_end" \
