+
+    script_dir = Path(__file__).parent
+    log_event = script_dir / "log-event.sh"
+    if not log_event.exists() or not shutil.which("bash"):
+        print(
+            f"[config] routing_preference_malformed: {location}[{index}]: {reason}",
+            file=sys.stderr,
+        )
+        return
+
+    payload = json.dumps({
