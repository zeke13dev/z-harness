+     description="Memory review for <slug>",
+     prompt="run_dir: <RUN_DIR>\ncumulative_diff_path: <cumulative.diff path>\nspec_path: $BASE/SPEC.md\ntags_path: docs/llm/TAGS.txt\nrun_id: <RRUN>\nparent_command: review-all"
