+     description="Memory review for <SLUG_FOR_DESC>",
+     prompt="run_dir: <RUN_DIR>
+   cumulative_diff_path: <CUMULATIVE_DIFF_PATH>
+   spec_path: <SPEC_PATH>
+   tags_path: <TAGS_PATH>
