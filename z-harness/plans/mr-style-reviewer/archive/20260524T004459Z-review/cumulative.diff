+    Each finding dict must have: id, severity, category, file, title.
+    """
+    index_lines = "\n".join(
+        f"  - {{id: {f['id']}, severity: {f['severity']}, "
+        f"category: {f['category']}, file: {f['file']}, title: {f['title']}}}"
+        for f in findings
+    )
+    return (
+        f"---\n"
+        f"artifact: mr-review\n"
+        f"slug: {slug}\n"
+        f"run_id: {run_id}\n"
+        f"findings_index:\n"
+        f"{index_lines}\n"
+        f"---\n\n"
+        f"# MR Review — {slug}\n"
+    )
