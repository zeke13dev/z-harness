+```bash
+COMPONENTS_MD_CONTENT="$(cat "$Z_HARNESS_PLAN_DIR/COMPONENTS.md")"
+SOURCE_MAP_PATHS="$(python3 -c 'import json,sys; paths=json.loads(sys.argv[1]); print("\n".join(paths))' "$SOURCE_MAP_JSON")"
