index 0000000..8e6b746
--- /dev/null
+++ b/scripts/regenerate-memories-flat.py
@@ -0,0 +1,156 @@
+#!/usr/bin/env python3
+"""
+Regenerate docs/llm/MEMORIES-FLAT.md from all docs/llm/*.json (except INDEX.json).
+
+Usage:
+    python3 scripts/regenerate-memories-flat.py --repo-root <abs path> [--dry-run]
+
+Exit codes:
+    0 — success
+    1 — input error (bad args, missing repo-root, unreadable JSON)
+    2 — write error (failed to write output file)
+"""
+
+import argparse
+import json
+import os
+import random
+import sys
+from pathlib import Path
+
+HEADER_LINE_1 = "# MEMORIES-FLAT.md — generated by /z-maintain-docs; do not edit by hand."
+HEADER_LINE_2 = "# Format: [<slug>] [<TYPE> <DATE>] [<source>] <text> (tags: ...)"
+
+
+def format_memory_line(slug: str, memory: dict) -> str:
+    """Format a single memory dict into the MEMORIES-FLAT.md line format."""
+    mem_type = memory.get("type", "unknown")
+    date = memory.get("date", "0000-00-00")
+    source = memory.get("source", "")
+    text = memory.get("text", "")
+    tags = memory.get("tags", [])
+    tags_str = ", ".join(tags) if tags else ""
+    return f"[{slug}] [{mem_type} {date}] [{source}] {text} (tags: {tags_str})"
+
+
+def load_memories(llm_dir: Path) -> list[tuple[str, str, dict]]:
+    """
+    Scan all *.json files in llm_dir except INDEX.json.
+    Return list of (slug, date, memory_dict) tuples.
+    Concepts without 'memories' field are treated as empty (skip, no crash).
+    """
+    entries = []
+    for json_path in sorted(llm_dir.glob("*.json")):
+        if json_path.name == "INDEX.json":
+            continue
+        try:
+            with open(json_path, "r", encoding="utf-8") as f:
+                data = json.load(f)
+        except (json.JSONDecodeError, OSError) as exc:
+            print(
+                f"ERROR: could not read {json_path}: {exc}",
+                file=sys.stderr,
+            )
+            sys.exit(1)
+
+        # Derive slug from filename (strip .json)
+        slug = json_path.stem
+
+        # Treat missing 'memories' as empty — do not crash
+        memories = data.get("memories", [])
+        if not isinstance(memories, list):
+            memories = []
+
+        for mem in memories:
+            if not isinstance(mem, dict):
+                continue
+            date = mem.get("date", "0000-00-00")
+            entries.append((slug, date, mem))
+
+    return entries
+
+
+def sort_key(entry: tuple[str, str, dict]) -> tuple[str, str]:
+    """Sort lex by slug ascending, then by date descending."""
+    slug, date, _ = entry
+    # Negate date by inverting: use a string that sorts earlier for later dates.
+    # For descending date within same slug, we negate using a complement trick:
+    # Since dates are YYYY-MM-DD, we can subtract from "9999-99-99" conceptually,
+    # but a simpler approach: sort by (slug, inverted_date).
+    inverted_date = "".join(chr(ord("9") - ord(c)) if c.isdigit() else c for c in date)
+    return (slug, inverted_date)
+
+
+def build_output_lines(entries: list[tuple[str, str, dict]]) -> list[str]:
+    """Build the full list of output lines (header + memory lines)."""
+    lines = [HEADER_LINE_1, HEADER_LINE_2]
+    sorted_entries = sorted(entries, key=sort_key)
+    for slug, _date, mem in sorted_entries:
+        lines.append(format_memory_line(slug, mem))
+    return lines
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(
+        description="Regenerate docs/llm/MEMORIES-FLAT.md"
+    )
+    parser.add_argument(
+        "--repo-root",
+        required=True,
+        help="Absolute path to the repository root",
+    )
+    parser.add_argument(
+        "--dry-run",
+        action="store_true",
+        help="Print proposed file to stdout instead of writing",
+    )
+    args = parser.parse_args()
+
+    repo_root = Path(args.repo_root)
+    llm_dir = repo_root / "docs" / "llm"
+
+    if not llm_dir.is_dir():
+        print(
+            f"ERROR: docs/llm directory not found at {llm_dir}",
+            file=sys.stderr,
+        )
+        sys.exit(1)
+
+    # Load memories from all concept JSONs
+    entries = load_memories(llm_dir)
+
+    # Build output
+    output_lines = build_output_lines(entries)
+    output_text = "\n".join(output_lines) + "\n"
+
+    if args.dry_run:
+        sys.stdout.write(output_text)
+        sys.exit(0)
+
+    # Atomic write: write to tmp file then os.replace()
+    canonical_path = llm_dir / "MEMORIES-FLAT.md"
+    pid = os.getpid()
+    rand_suffix = random.randrange(0, 2**32)
+    tmp_path = llm_dir / f"MEMORIES-FLAT.md.tmp.{pid}.{rand_suffix}"
+
+    try:
+        with open(tmp_path, "w", encoding="utf-8") as f:
+            f.write(output_text)
+        os.replace(tmp_path, canonical_path)
+    except OSError as exc:
+        print(
+            f"ERROR: could not write {canonical_path}: {exc}",
+            file=sys.stderr,
+        )
+        # Clean up tmp if it exists
+        try:
+            tmp_path.unlink(missing_ok=True)
+        except OSError:
+            pass
+        sys.exit(2)
+
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()

