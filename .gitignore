.claude/settings.local.json
.claude/worktrees/
.DS_Store
*.swp
.antigravitycli/

# Per-user provider config (repo-local override). The tracked
# .z-harness/providers.json project default is an intentional exception.
.z-harness/

# Build artifacts
dist/
__pycache__/
*.pyc

# Stray top-level archive (agent debris; canonical location is z-harness/archive/)
/archive/

# Generated per-host exports — regenerated on demand, never committed.
# skills/ is the only hand-authored committed source tier; export drivers emit
# host-native trees (.cursor/skills, .agent/skills, codex skills, …) to a temp
# dir or install location. Locally installed plugin caches live here too.
/exports/
# On-demand generate target output (make export / generate-exports.py default dest).
/temp/exports/
/.cursor/
/prompts/
/.agent/
/.pi/
# Generated OMP exports only. The tracked .omp/config.yml project default stays.
/.omp/z-harness/
/.hermes/
/.codex-plugin/
/.claude/scheduled_tasks.lock


# Generated z-report context bundle.
/context.json
# Ad-hoc local research scratch
/research/

# Runtime state — reflects live environment, not repo state
runtime/drivers/antigravity/READY
runtime/drivers/codex/probe_results.json

# z-harness runtime — plan artifacts, archives, telemetry, ambient plan dirs.
# Everything under z-harness/ is local workflow output; not version-controlled.
# The canonical artifact base is external (~/.local/state/z-harness/<repo-id>/);
# these in-repo dirs are legacy/ambient fallbacks and must never be tracked.
z-harness/
/plans/
/state/
.z-harness/plans/

# Stale tmpfiles from aborted diff captures / atomic-write fallouts
*.tmp
